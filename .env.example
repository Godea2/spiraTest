# Copy to .env.local and fill in. Never commit real values.

# Team password for the sign-in screen.
APP_PASSWORD=

# Signs session cookies and comparisons, and encrypts saved webhook URL overrides.
# Use a long random string (at least 16 characters). Changing it signs everyone out
# and means existing drafts must be recompared before apply.
SESSION_SECRET=

# Shared secret sent to n8n as the X-Webhook-Secret header.
WEBHOOK_SECRET=

# Fallback n8n webhook URLs. Each browser can override these in Settings.
RECONCILE_WEBHOOK_URL=
APPLY_WEBHOOK_URL=
