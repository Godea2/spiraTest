# Copy to .env.local and fill in. Never commit real values.

# Team password for the sign-in screen.
APP_PASSWORD=

# Signs session cookies. Use a long random string (at least 16 characters).
SESSION_SECRET=

# Shared secret sent to n8n as the X-Webhook-Secret header.
WEBHOOK_SECRET=

# Fallback n8n webhook URLs. Admins can override these in Settings.
RECONCILE_WEBHOOK_URL=
APPLY_WEBHOOK_URL=

# Optional: where settings, drafts and the activity log are stored (default ./data).
# DATA_DIR=
